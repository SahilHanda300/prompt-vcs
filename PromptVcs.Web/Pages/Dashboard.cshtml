@page
@model PromptVcs.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <h1 class="text-2xl sm:text-3xl font-bold mb-2">Your prompts</h1>
    <p class="text-brown-500 dark:text-brown-400 mb-8">Every submission is checked and published automatically — no manual steps.</p>

    <partial name="_Toast" model="new ToastData(Model.ErrorMessage, null)" />

    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-10">
        <h2 class="text-lg font-semibold mb-4">New prompt</h2>
        <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="flex flex-col gap-4">
            <div>
                <label for="NewPromptName" class="block text-sm font-medium mb-1.5">Name</label>
                <input type="text" id="NewPromptName" name="NewPromptName" value="@Model.NewPromptName" maxlength="80"
                       placeholder="e.g. coffee-shop-landing"
                       class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="NewPromptContent" class="block text-sm font-medium mb-1.5">Prompt</label>
                <textarea id="NewPromptContent" name="NewPromptContent" rows="4"
                          placeholder="Describe the site or app you want..."
                          class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400">@Model.NewPromptContent</textarea>
            </div>
            <div>
                <label for="Attachments" class="block text-sm font-medium mb-1.5">Reference images (optional)</label>
                <input type="file" id="Attachments" name="Attachments" multiple accept="image/*"
                       class="w-full text-sm text-brown-500 dark:text-brown-400 file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:bg-brown-200 dark:file:bg-brown-700 file:text-brown-800 dark:file:text-brown-100 file:text-sm file:font-medium hover:file:bg-brown-300 dark:hover:file:bg-brown-600" />
                <p class="mt-1.5 text-xs text-brown-500 dark:text-brown-400">Up to 4 images, 2MB each. Used as visual context for generation (e.g. a logo to incorporate).</p>
            </div>
            <button type="submit"
                    class="self-start px-6 py-2.5 rounded-lg bg-brown-500 hover:bg-brown-600 text-white font-semibold text-sm transition active:scale-[0.97]">
                Submit &amp; run pipeline
            </button>
        </form>
    </div>

    <h2 class="text-lg font-semibold mb-4">Existing prompts</h2>

    @if (Model.Prompts.Count == 0)
    {
        <p class="text-brown-500 dark:text-brown-400 text-sm">No prompts yet — submit one above to get started.</p>
    }
    else
    {
        <div class="flex flex-col gap-3">
            @foreach (var p in Model.Prompts)
            {
                var itemStatus = PromptVcs.Web.PipelineStatus.ForListItem(p);
                <a asp-page="/Prompt" asp-route-name="@p.Name"
                   class="block bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-4 sm:p-5 transition-all duration-200 hover:border-brown-500 dark:hover:border-brown-400 hover:-translate-y-0.5">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                        <span class="font-semibold">@p.Name</span>
                        <span class="text-xs @(itemStatus.Failed ? "text-red-600 dark:text-red-400" : itemStatus.Percent == 100 ? "text-emerald-600 dark:text-emerald-400" : "text-brown-500 dark:text-brown-400")">
                            @itemStatus.Message (@itemStatus.Percent%)
                        </span>
                    </div>
                    <div class="h-1.5 rounded-full bg-brown-200 dark:bg-brown-700 overflow-hidden">
                        <div class="h-full rounded-full @(itemStatus.Failed ? "bg-red-500" : "bg-emerald-500")" style="width: @(itemStatus.Percent)%"></div>
                    </div>
                </a>
            }
        </div>
    }
</section>
