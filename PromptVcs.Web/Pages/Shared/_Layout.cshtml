<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] — PromptVCS</title>
<link rel="icon" type="image/svg+xml" href="~/favicon.svg">
<script>
    // Runs synchronously, before Tailwind loads/paints anything, so the
    // page never flashes the wrong theme for a frame. Explicit choice
    // (localStorage) wins; otherwise falls back to the OS/browser
    // preference. Tailwind's class-based dark mode just checks for this
    // "dark" class on <html>, so setting it this early is all that's needed.
    (function () {
        var stored = localStorage.getItem('promptvcs-theme');
        var wantsDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (wantsDark) document.documentElement.classList.add('dark');
    })();
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'sans-serif'],
                    mono: ['"SFMono-Regular"', 'Consolas', '"Liberation Mono"', 'Menlo', 'monospace']
                }
            }
        }
    };
</script>
</head>
<body class="min-h-screen flex flex-col bg-stone-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans antialiased overflow-x-hidden transition-colors duration-200">
<header class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-8 py-4 border-b border-slate-200 dark:border-slate-700">
    <a href="/" class="flex items-center gap-2 font-semibold text-base sm:text-lg">
        <svg viewBox="0 0 64 64" aria-hidden="true" class="w-7 h-7">
            <rect width="64" height="64" rx="14" fill="#0f172a" />
            <path d="M18 20 L32 32 L18 44" fill="none" stroke="#22d3ee" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="36" y="38" width="14" height="6" rx="3" fill="#22d3ee" />
        </svg>
        <span>PromptVCS</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2 text-sm">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span title="Signed in as @User.Identity!.Name" aria-label="Signed in as @User.Identity!.Name"
                  class="p-2 rounded-md text-slate-500 dark:text-slate-400">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                    <circle cx="12" cy="8" r="3.25" />
                    <path stroke-linecap="round" d="M5.5 20c1.1-3.4 3.9-5.25 6.5-5.25S17.4 16.6 18.5 20" />
                </svg>
            </span>
            @if (User.IsPromptVcsAdmin())
            {
                <a href="/Admin" title="Admin" aria-label="Admin"
                   class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                    </svg>
                </a>
            }
            <a href="/Dashboard" title="Dashboard" aria-label="Dashboard"
               class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                    <rect x="3.5" y="3.5" width="7" height="7" rx="1.25" />
                    <rect x="13.5" y="3.5" width="7" height="7" rx="1.25" />
                    <rect x="3.5" y="13.5" width="7" height="7" rx="1.25" />
                    <rect x="13.5" y="13.5" width="7" height="7" rx="1.25" />
                </svg>
            </a>
            @if (!User.IsPromptVcsAdmin())
            {
                <a href="/Settings" title="Settings" aria-label="Settings"
                   class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                        <circle cx="12" cy="12" r="2.75" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.4 13.5a7.6 7.6 0 0 0 0-3l1.6-1.4-1.5-2.6-2 .6a7.6 7.6 0 0 0-2.6-1.5l-.4-2.1h-3l-.4 2.1a7.6 7.6 0 0 0-2.6 1.5l-2-.6-1.5 2.6 1.6 1.4a7.6 7.6 0 0 0 0 3l-1.6 1.4 1.5 2.6 2-.6a7.6 7.6 0 0 0 2.6 1.5l.4 2.1h3l.4-2.1a7.6 7.6 0 0 0 2.6-1.5l2 .6 1.5-2.6-1.6-1.4z" />
                    </svg>
                </a>
            }
            <form method="post" asp-page="/Logout" class="inline">
                <button type="submit" title="Log out" aria-label="Log out"
                        class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-red-600 dark:hover:text-red-400 transition-colors">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h7A1.5 1.5 0 0 1 19 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 9 18.5V17" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 12H5m0 0l3-3m-3 3l3 3" />
                    </svg>
                </button>
            </form>
        }
        else
        {
            <a href="/Login" title="Log in" aria-label="Log in"
               class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7V5.5A1.5 1.5 0 0 0 13.5 4h-7A1.5 1.5 0 0 0 5 5.5v13A1.5 1.5 0 0 0 6.5 20h7a1.5 1.5 0 0 0 1.5-1.5V17" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H9.5m9.5 0l-3-3m3 3l-3 3" />
                </svg>
            </a>
            <a href="/Register" title="Get started — create an account" aria-label="Get started — create an account"
               class="p-2 rounded-md bg-blue-500 hover:bg-blue-600 text-white transition-colors">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                    <circle cx="9.5" cy="8" r="3.25" />
                    <path stroke-linecap="round" d="M3.5 20c1-3.3 3.6-5.1 6-5.1s5 1.8 6 5.1" />
                    <path stroke-linecap="round" d="M18.5 8v4.5M16.25 10.25h4.5" />
                </svg>
            </a>
        }
        <button id="themeToggle" type="button" aria-label="Toggle dark mode"
                class="p-2 rounded-md text-slate-500 hover:bg-slate-200 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-100 transition-colors">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="w-5 h-5 block dark:hidden">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
                <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="w-5 h-5 hidden dark:block">
                <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
            </svg>
        </button>
    </nav>
</header>

<main class="flex-1">
    @RenderBody()
</main>

<footer class="text-center py-6 text-slate-500 dark:text-slate-400 text-xs sm:text-sm border-t border-slate-200 dark:border-slate-700">
    <span>PromptVCS — version control for prompts</span>
</footer>

<div id="toast-container" aria-live="polite" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-[calc(100%-2rem)] max-w-sm"></div>

<script>
    document.getElementById('themeToggle').addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('promptvcs-theme', isDark ? 'dark' : 'light');
    });
</script>
<script>
    // Toasts are populated by _Toast.cshtml, included near the top of a
    // page's body — since script tags run in document order, any
    // window.__pendingToasts.push(...) calls from the page's own body
    // have already run by the time this drains the queue.
    (function () {
        var ERROR_ICON = '<path stroke-linecap="round" d="M12 8v5M12 16h.01"></path>';
        var SUCCESS_ICON = '<path stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-6"></path>';

        function showToast(type, message) {
            var container = document.getElementById('toast-container');
            if (!container) return;
            var isError = type === 'error';

            var toast = document.createElement('div');
            toast.className = 'flex items-start gap-3 px-4 py-3 rounded-lg shadow-lg border text-sm transition-all duration-300 ease-out translate-x-[120%] opacity-0 ' +
                (isError
                    ? 'bg-white dark:bg-slate-800 border-red-500 text-red-600 dark:text-red-400'
                    : 'bg-white dark:bg-slate-800 border-emerald-500 text-emerald-600 dark:text-emerald-400');

            var icon = document.createElement('span');
            icon.className = 'flex-none mt-0.5';
            icon.setAttribute('aria-hidden', 'true');
            // Static, trusted markup only (two fixed strings above) — never
            // built from the message text, so this innerHTML use can't be
            // an injection point.
            icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><circle cx="12" cy="12" r="10"></circle>' + (isError ? ERROR_ICON : SUCCESS_ICON) + '</svg>';

            var text = document.createElement('span');
            text.className = 'flex-1 pt-0.5';
            text.textContent = message; // textContent, never innerHTML — safe even if message contains markup-looking text

            var closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.setAttribute('aria-label', 'Dismiss');
            closeBtn.className = 'flex-none text-slate-400 hover:text-slate-700 dark:hover:text-slate-100 transition-colors';
            closeBtn.textContent = '×';

            toast.appendChild(icon);
            toast.appendChild(text);
            toast.appendChild(closeBtn);
            container.appendChild(toast);

            requestAnimationFrame(function () {
                toast.classList.remove('translate-x-[120%]', 'opacity-0');
            });

            var dismissed = false;
            function dismiss() {
                if (dismissed) return;
                dismissed = true;
                toast.classList.add('opacity-0');
                setTimeout(function () { toast.remove(); }, 200);
            }
            closeBtn.addEventListener('click', dismiss);
            setTimeout(dismiss, 6000);
        }

        (window.__pendingToasts || []).forEach(function (t) { showToast(t.type, t.message); });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
