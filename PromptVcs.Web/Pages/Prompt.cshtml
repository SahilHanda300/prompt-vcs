@page "{name}"
@model PromptVcs.Web.Pages.PromptModel
@{
    ViewData["Title"] = Model.Name;
    var latestBuild = Model.Record?.Builds.LastOrDefault();
    var status = Model.Record != null ? PromptVcs.Web.PipelineStatus.ForRecord(Model.Record) : null;
}

<section class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <a asp-page="/Dashboard" class="text-sm text-brown-500 dark:text-brown-400 hover:text-brown-600 dark:hover:text-brown-400 transition">&larr; All prompts</a>

    <partial name="_Toast" model="new ToastData(Model.ErrorMessage, Model.SuccessMessage)" />

    @if (Model.Record != null)
    {
        var record = Model.Record;

        <div class="flex flex-wrap items-center gap-3 mt-4 mb-5">
            <h1 class="text-2xl sm:text-3xl font-bold">@record.Name</h1>
            @if (Model.CanEditContent)
            {
                <form method="post" asp-page-handler="ToggleFavorite">
                    <button type="submit" title="@(record.IsFavorite ? "Unfavorite" : "Favorite")" aria-label="@(record.IsFavorite ? "Unfavorite" : "Favorite")"
                            class="p-1.5 rounded-md transition active:scale-90 @(record.IsFavorite ? "text-brown-600 dark:text-brown-300" : "text-brown-300 dark:text-brown-600 hover:text-brown-500 dark:hover:text-brown-400")">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="@(record.IsFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.5" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L12 3.5z" />
                        </svg>
                    </button>
                </form>
            }
            @if (!Model.CanEditContent)
            {
                <span class="px-2.5 py-1 rounded-full border border-brown-300 dark:border-brown-600 text-brown-500 dark:text-brown-400 text-xs font-medium">Owned by @record.Owner</span>
            }
        </div>

        @if (status != null)
        {
            <div class="mb-10 p-5 rounded-xl border @(status.Failed ? "border-red-500 bg-red-500/10" : status.Percent == 100 ? "border-emerald-500 bg-emerald-500/10" : "border-brown-200 dark:border-brown-700 bg-white dark:bg-brown-800")">
                <div class="flex items-center justify-between mb-2.5">
                    <span class="font-semibold @(status.Failed ? "text-red-600 dark:text-red-400" : status.Percent == 100 ? "text-emerald-600 dark:text-emerald-400" : "text-brown-800 dark:text-brown-100")">
                        @status.Message
                    </span>
                    <span class="text-sm text-brown-500 dark:text-brown-400">@status.Percent% Completed</span>
                </div>
                <div class="h-2.5 rounded-full bg-brown-200 dark:bg-brown-700 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @(status.Failed ? "bg-red-500" : "bg-emerald-500")" style="width: @(status.Percent)%"></div>
                </div>
                @if (status.Percent == 100 && latestBuild != null && !string.IsNullOrEmpty(latestBuild.ArtifactUrl))
                {
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 mt-3.5">
                        <a href="@(Model.SiteBaseUrl + latestBuild.ArtifactUrl)" target="_blank" rel="noopener"
                           class="text-brown-600 dark:text-brown-400 hover:underline text-sm">View your site &rarr;</a>
                        <a href="@(Model.SiteBaseUrl)/site/@(record.Id)/download"
                           class="text-brown-600 dark:text-brown-400 hover:underline text-sm">Download code</a>
                    </div>
                }
                @if (status.Failed && !string.IsNullOrEmpty(status.Detail))
                {
                    <p class="mt-3.5 text-sm text-brown-500 dark:text-brown-400">@status.Detail</p>
                }
            </div>
        }

        @if (Model.CanEditContent)
        {
            <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-10">
                <h2 class="text-lg font-semibold mb-4">Submit an edit</h2>
                <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Runs the whole pipeline again from a new version — no separate promote step.</p>
                <form method="post" asp-page-handler="Edit" enctype="multipart/form-data" class="flex flex-col gap-4">
                    <textarea name="EditContent" rows="6"
                              class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brown-400">@Model.EditContent</textarea>
                    <div>
                        <label for="Attachments" class="block text-xs font-medium mb-1.5 text-brown-500 dark:text-brown-400">Reference images (optional)</label>
                        <input type="file" id="Attachments" name="Attachments" multiple accept="image/*"
                               class="w-full text-sm text-brown-500 dark:text-brown-400 file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:bg-brown-200 dark:file:bg-brown-700 file:text-brown-800 dark:file:text-brown-100 file:text-sm file:font-medium hover:file:bg-brown-300 dark:hover:file:bg-brown-600" />
                        <p class="mt-1.5 text-xs text-brown-500 dark:text-brown-400">Up to 4 images, 2MB each. Only this submission's attachments are sent — re-attach on later edits if still needed.</p>
                    </div>
                    <button type="submit"
                            class="self-start px-6 py-2.5 rounded-lg bg-brown-500 hover:bg-brown-600 text-white font-semibold text-sm transition active:scale-[0.97]">
                        Submit &amp; run pipeline
                    </button>
                </form>

                @{ var currentAttachments = record.History.FirstOrDefault(h => h.Version == Model.Version)?.Attachments; }
                @if (currentAttachments is { Count: > 0 })
                {
                    <div class="mt-5 pt-5 border-t border-brown-200 dark:border-brown-700">
                        <p class="text-xs font-medium mb-2.5 text-brown-500 dark:text-brown-400">Attached to v@(Model.Version)</p>
                        <div class="flex flex-wrap gap-2.5">
                            @foreach (var attachment in currentAttachments)
                            {
                                <img src="data:@attachment.ContentType;base64,@attachment.Base64Data" alt="@attachment.FileName"
                                     title="@attachment.FileName"
                                     class="w-16 h-16 object-cover rounded-lg border border-brown-300 dark:border-brown-600" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-10">
                <h2 class="text-lg font-semibold mb-4">Admin actions</h2>
                <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">This prompt belongs to another user — its content is shown read-only. You can rename it or delete it.</p>

                <textarea rows="6" readonly disabled
                          class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm font-mono opacity-80 cursor-not-allowed">@Model.EditContent</textarea>

                <div class="flex flex-wrap items-center gap-4 mt-4">
                    <form method="post" asp-page-handler="Rename" class="flex items-center gap-2">
                        <input type="text" name="NewPromptName" value="@Model.NewPromptName" placeholder="New name" maxlength="80"
                               class="px-3 py-2 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                        <button type="submit" title="Rename" aria-label="Rename"
                                class="p-2 rounded-md text-brown-600 dark:text-brown-300 hover:bg-brown-200 dark:hover:bg-brown-700 hover:text-brown-800 dark:hover:text-brown-100 transition active:scale-90">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 4.5l3 3L8 19H5v-3L16.5 4.5z" />
                            </svg>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Delete">
                        <button type="submit" title="Delete prompt" aria-label="Delete prompt"
                                class="p-2 rounded-md text-brown-600 dark:text-brown-300 hover:bg-red-100 dark:hover:bg-red-900/40 hover:text-red-600 dark:hover:text-red-400 transition active:scale-90">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 7h14M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m2 0v12a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 19V7h10z" />
                                <path stroke-linecap="round" d="M10 11v6M14 11v6" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-10">
            <h2 class="text-lg font-semibold mb-4">QA history</h2>
            @if (record.QaCheckpoints.Count == 0)
            {
                <p class="text-brown-500 dark:text-brown-400 text-sm">No QA checkpoints yet.</p>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    @foreach (var checkpoint in record.QaCheckpoints.AsEnumerable().Reverse())
                    {
                        <div class="p-3.5 rounded-lg border @(checkpoint.Passed ? "border-brown-200 dark:border-brown-700" : "border-red-500/60") bg-brown-50 dark:bg-brown-900">
                            <div class="flex items-center justify-between text-sm mb-2">
                                <span class="font-medium">Version @checkpoint.Version</span>
                                <span class="@(checkpoint.Passed ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400") font-medium">
                                    @(checkpoint.Passed ? "Passed" : "Failed")
                                </span>
                            </div>
                            <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-brown-500 dark:text-brown-400">
                                <span>@(checkpoint.Checks.Validation.Passed ? "✓" : "✗") Validation</span>
                                <span>@(checkpoint.Checks.ContentSafety.Passed ? "✓" : "✗") Content safety</span>
                                <span>@(checkpoint.Checks.TrialGeneration.Passed ? "✓" : "✗") Trial generation</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6">
            <h2 class="text-lg font-semibold mb-4">Compare versions</h2>
            <form method="get" class="flex flex-wrap items-end gap-3 mb-5">
                <input type="hidden" name="name" value="@Model.Name" />
                <div>
                    <label for="V1" class="block text-xs font-medium mb-1.5 text-brown-500 dark:text-brown-400">From</label>
                    <select id="V1" name="V1" class="px-3 py-2 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm">
                        @foreach (var v in record.History)
                        {
                            <option value="@v.Version" selected="@(Model.V1 == v.Version)">v@(v.Version) — @v.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="V2" class="block text-xs font-medium mb-1.5 text-brown-500 dark:text-brown-400">To</label>
                    <select id="V2" name="V2" class="px-3 py-2 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm">
                        @foreach (var v in record.History)
                        {
                            <option value="@v.Version" selected="@(Model.V2 == v.Version)">v@(v.Version) — @v.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</option>
                        }
                    </select>
                </div>
                <button type="submit" class="px-5 py-2 rounded-lg bg-brown-200 hover:bg-brown-300 dark:bg-brown-700 dark:hover:bg-brown-600 text-brown-800 dark:text-brown-100 font-semibold text-sm transition">Diff</button>
            </form>

            @if (Model.Diff != null)
            {
                var added = Model.Diff.ContentDiff.Count(l => l.Type == "inserted");
                var removed = Model.Diff.ContentDiff.Count(l => l.Type == "deleted");
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3 text-xs text-brown-500 dark:text-brown-400">
                    <span>Comparing v@(Model.V1) &rarr; v@(Model.V2)</span>
                    <span class="text-emerald-600 dark:text-emerald-400">+@added</span>
                    <span class="text-red-600 dark:text-red-400">-@removed</span>
                    @if (record.Environments.Prod == Model.V1)
                    {
                        <span class="px-2 py-0.5 rounded-full border border-emerald-500 text-emerald-600 dark:text-emerald-400">v@(Model.V1) is live</span>
                    }
                    @if (record.Environments.Prod == Model.V2)
                    {
                        <span class="px-2 py-0.5 rounded-full border border-emerald-500 text-emerald-600 dark:text-emerald-400">v@(Model.V2) is live</span>
                    }
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
                    @foreach (var info in new[] { Model.Diff.V1, Model.Diff.V2 })
                    {
                        <div class="p-3 rounded-lg border border-brown-200 dark:border-brown-700 bg-brown-50 dark:bg-brown-900 text-xs">
                            <div class="font-medium mb-1.5">v@(info.Version) &mdash; @info.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                            <div class="flex flex-wrap gap-x-4 gap-y-1 text-brown-500 dark:text-brown-400">
                                @if (info.QaPassed == null)
                                {
                                    <span>No QA checkpoint</span>
                                }
                                else
                                {
                                    <span class="@(info.QaPassed == true ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">@(info.QaPassed == true ? "QA passed" : "QA failed")</span>
                                }
                                @if (info.BuildStatus == null)
                                {
                                    <span>No build</span>
                                }
                                else
                                {
                                    <span class="@(info.BuildStatus == "success" ? "text-emerald-600 dark:text-emerald-400" : info.BuildStatus == "failed" ? "text-red-600 dark:text-red-400" : "text-yellow-600 dark:text-yellow-400")">Build @info.BuildStatus (v@(info.BuildVersion))</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <p class="text-xs font-medium mb-2 text-brown-500 dark:text-brown-400">Prompt text</p>
                <div class="rounded-lg border border-brown-200 dark:border-brown-700 overflow-hidden font-mono text-xs mb-5">
                    @foreach (var line in Model.Diff.ContentDiff)
                    {
                        var rowClass = line.Type switch
                        {
                            "inserted" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-l-2 border-emerald-500",
                            "deleted" => "bg-red-500/10 text-red-700 dark:text-red-300 border-l-2 border-red-500",
                            "modified" => "bg-yellow-500/10 text-yellow-700 dark:text-yellow-200 border-l-2 border-yellow-500",
                            _ => "text-brown-500 dark:text-brown-400 border-l-2 border-transparent",
                        };
                        var prefix = line.Type switch { "inserted" => "+", "deleted" => "-", _ => " " };
                        <div class="@rowClass px-3 py-1 whitespace-pre-wrap break-words">@prefix @line.Text</div>
                    }
                </div>

                <p class="text-xs font-medium mb-2 text-brown-500 dark:text-brown-400">Generated code</p>
                @if (Model.Diff.ArtifactDiff != null)
                {
                    <div class="rounded-lg border border-brown-200 dark:border-brown-700 overflow-hidden font-mono text-xs max-h-96 overflow-y-auto">
                        @foreach (var line in Model.Diff.ArtifactDiff)
                        {
                            var rowClass = line.Type switch
                            {
                                "inserted" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-l-2 border-emerald-500",
                                "deleted" => "bg-red-500/10 text-red-700 dark:text-red-300 border-l-2 border-red-500",
                                "modified" => "bg-yellow-500/10 text-yellow-700 dark:text-yellow-200 border-l-2 border-yellow-500",
                                _ => "text-brown-500 dark:text-brown-400 border-l-2 border-transparent",
                            };
                            var prefix = line.Type switch { "inserted" => "+", "deleted" => "-", _ => " " };
                            <div class="@rowClass px-3 py-1 whitespace-pre-wrap break-words">@prefix @line.Text</div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-brown-500 dark:text-brown-400">No generated-code diff &mdash; one or both versions never produced a successful build.</p>
                }
            }
        </div>
    }
</section>
