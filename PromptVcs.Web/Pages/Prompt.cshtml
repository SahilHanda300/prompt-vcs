@page "{name}"
@model PromptVcs.Web.Pages.PromptModel
@{
    ViewData["Title"] = Model.Name;
    var latestBuild = Model.Record?.Builds.LastOrDefault();
    var status = Model.Record != null ? PromptVcs.Web.PipelineStatus.ForRecord(Model.Record) : null;
}

<section class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <a asp-page="/Dashboard" class="text-sm text-slate-400 hover:text-cyan-400 transition-colors">&larr; All prompts</a>

    @if (Model.ErrorMessage != null)
    {
        <div class="mt-4 px-4 py-3 rounded-lg border border-red-500 bg-red-500/10 text-red-400 text-sm">@Model.ErrorMessage</div>
    }

    @if (Model.Record != null)
    {
        var record = Model.Record;

        <h1 class="text-2xl sm:text-3xl font-bold mt-4 mb-5">@record.Name</h1>

        @if (status != null)
        {
            <div class="mb-10 p-5 rounded-xl border @(status.Failed ? "border-red-500 bg-red-500/10" : status.Percent == 100 ? "border-emerald-500 bg-emerald-500/10" : "border-slate-800 bg-slate-900")">
                <div class="flex items-center justify-between mb-2.5">
                    <span class="font-semibold @(status.Failed ? "text-red-400" : status.Percent == 100 ? "text-emerald-400" : "text-slate-100")">
                        @status.Message
                    </span>
                    <span class="text-sm text-slate-400">@status.Percent% Completed</span>
                </div>
                <div class="h-2.5 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @(status.Failed ? "bg-red-500" : "bg-emerald-500")" style="width: @(status.Percent)%"></div>
                </div>
                @if (status.Percent == 100 && latestBuild != null && !string.IsNullOrEmpty(latestBuild.ArtifactUrl))
                {
                    <a href="@(Model.SiteBaseUrl + latestBuild.ArtifactUrl)" target="_blank" rel="noopener"
                       class="inline-block mt-3.5 text-cyan-400 hover:underline text-sm">View your site &rarr;</a>
                }
                @if (status.Failed && !string.IsNullOrEmpty(status.Detail))
                {
                    <p class="mt-3.5 text-sm text-slate-400">@status.Detail</p>
                }
            </div>
        }

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 sm:p-6 mb-10">
            <h2 class="text-lg font-semibold mb-4">Submit an edit</h2>
            <p class="text-slate-400 text-sm mb-4">Runs the whole pipeline again from a new version — no separate promote step.</p>
            <form method="post" asp-page-handler="Edit" class="flex flex-col gap-4">
                <textarea name="EditContent" required rows="6"
                          class="w-full px-3 py-2.5 rounded-lg border border-slate-700 bg-slate-950 text-slate-100 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-cyan-400">@Model.EditContent</textarea>
                <button type="submit"
                        class="self-start px-6 py-2.5 rounded-lg bg-blue-500 hover:bg-blue-600 text-white font-semibold text-sm transition-colors">
                    Submit &amp; run pipeline
                </button>
            </form>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 sm:p-6 mb-10">
            <h2 class="text-lg font-semibold mb-4">QA history</h2>
            @if (record.QaCheckpoints.Count == 0)
            {
                <p class="text-slate-400 text-sm">No QA checkpoints yet.</p>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    @foreach (var checkpoint in record.QaCheckpoints.AsEnumerable().Reverse())
                    {
                        <div class="p-3.5 rounded-lg border @(checkpoint.Passed ? "border-slate-800" : "border-red-500/60") bg-slate-950">
                            <div class="flex items-center justify-between text-sm mb-2">
                                <span class="font-medium">Version @checkpoint.Version</span>
                                <span class="@(checkpoint.Passed ? "text-emerald-400" : "text-red-400") font-medium">
                                    @(checkpoint.Passed ? "Passed" : "Failed")
                                </span>
                            </div>
                            <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-slate-400">
                                <span>@(checkpoint.Checks.Validation.Passed ? "✓" : "✗") Validation</span>
                                <span>@(checkpoint.Checks.ContentSafety.Passed ? "✓" : "✗") Content safety</span>
                                <span>@(checkpoint.Checks.TrialGeneration.Passed ? "✓" : "✗") Trial generation</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 sm:p-6">
            <h2 class="text-lg font-semibold mb-4">Compare versions</h2>
            <form method="get" class="flex flex-wrap items-end gap-3 mb-5">
                <input type="hidden" name="name" value="@Model.Name" />
                <div>
                    <label for="V1" class="block text-xs font-medium mb-1.5 text-slate-400">From</label>
                    <select id="V1" name="V1" class="px-3 py-2 rounded-lg border border-slate-700 bg-slate-950 text-slate-100 text-sm">
                        @foreach (var v in record.History)
                        {
                            <option value="@v.Version" selected="@(Model.V1 == v.Version)">v@(v.Version) — @v.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="V2" class="block text-xs font-medium mb-1.5 text-slate-400">To</label>
                    <select id="V2" name="V2" class="px-3 py-2 rounded-lg border border-slate-700 bg-slate-950 text-slate-100 text-sm">
                        @foreach (var v in record.History)
                        {
                            <option value="@v.Version" selected="@(Model.V2 == v.Version)">v@(v.Version) — @v.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</option>
                        }
                    </select>
                </div>
                <button type="submit" class="px-5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-100 font-semibold text-sm transition-colors">Diff</button>
            </form>

            @if (Model.DiffLines != null)
            {
                var added = Model.DiffLines.Count(l => l.Type == "inserted");
                var removed = Model.DiffLines.Count(l => l.Type == "deleted");
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3 text-xs text-slate-400">
                    <span>Comparing v@(Model.V1) &rarr; v@(Model.V2)</span>
                    <span class="text-emerald-400">+@added</span>
                    <span class="text-red-400">-@removed</span>
                    @if (record.Environments.Prod == Model.V1)
                    {
                        <span class="px-2 py-0.5 rounded-full border border-emerald-500 text-emerald-400">v@(Model.V1) is live</span>
                    }
                    @if (record.Environments.Prod == Model.V2)
                    {
                        <span class="px-2 py-0.5 rounded-full border border-emerald-500 text-emerald-400">v@(Model.V2) is live</span>
                    }
                </div>
                <div class="rounded-lg border border-slate-800 overflow-hidden font-mono text-xs">
                    @foreach (var line in Model.DiffLines)
                    {
                        var rowClass = line.Type switch
                        {
                            "inserted" => "bg-emerald-500/10 text-emerald-300 border-l-2 border-emerald-500",
                            "deleted" => "bg-red-500/10 text-red-300 border-l-2 border-red-500",
                            "modified" => "bg-yellow-500/10 text-yellow-200 border-l-2 border-yellow-500",
                            _ => "text-slate-400 border-l-2 border-transparent",
                        };
                        var prefix = line.Type switch { "inserted" => "+", "deleted" => "-", _ => " " };
                        <div class="@rowClass px-3 py-1 whitespace-pre-wrap break-words">@prefix @line.Text</div>
                    }
                </div>
            }
        </div>
    }
</section>
