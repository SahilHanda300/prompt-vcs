@page
@model PromptVcs.Web.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<section class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <h1 class="text-2xl sm:text-3xl font-bold mb-2">Admin dashboard</h1>
    <p class="text-brown-500 dark:text-brown-400 mb-8">Signed in as <strong class="text-brown-800 dark:text-brown-100 font-semibold">@User.Identity!.Name</strong> (admin).</p>

    <partial name="_Toast" model="new ToastData(Model.ErrorMessage, Model.SuccessMessage)" />

    <div class="relative mb-6">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-brown-400 dark:text-brown-500">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path stroke-linecap="round" d="M20 20l-4.3-4.3" />
        </svg>
        <input type="search" id="adminSearch" placeholder="Search users and prompts..." autocomplete="off"
               class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-white dark:bg-brown-800 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
        <p id="adminSearchNoResults" class="hidden mt-2 text-sm text-brown-500 dark:text-brown-400">No users or prompts match "<span id="adminSearchNoResultsQuery"></span>".</p>
    </div>

    <div class="flex gap-1 mb-6 border-b border-brown-200 dark:border-brown-700" role="tablist">
        <button type="button" data-tab="users" class="admin-tab px-4 py-2 text-sm font-medium border-b-2 -mb-px transition">Account &amp; Users</button>
        <button type="button" data-tab="prompts" class="admin-tab px-4 py-2 text-sm font-medium border-b-2 -mb-px transition">Prompts</button>
        <button type="button" data-tab="danger" class="admin-tab px-4 py-2 text-sm font-medium border-b-2 -mb-px transition">Danger Zone</button>
    </div>

    <div id="tab-users" class="admin-panel">
    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-6">
        <h2 class="text-lg font-semibold mb-1">Your account</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Enter your current password once, plus whichever of a new username or new password you want to change.</p>

        <form method="post" asp-page-handler="UpdateAccount" class="flex flex-col gap-3 max-w-sm">
            <div>
                <label for="CurrentPassword" class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">Current password</label>
                <input type="password" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password"
                       class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="NewUsername" class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">New username (optional)</label>
                <input type="text" id="NewUsername" name="NewUsername" value="@Model.NewUsername" autocomplete="username"
                       class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="NewPassword" class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">New password (optional, 8+ chars with letters and numbers)</label>
                <input type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" minlength="8"
                       pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" title="At least 8 characters, with letters and numbers"
                       class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="ConfirmNewPassword" class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">Confirm new password</label>
                <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" autocomplete="new-password" minlength="8"
                       class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <button type="submit" class="self-start px-4 py-1.5 rounded-md bg-brown-500 hover:bg-brown-600 text-white font-semibold text-xs transition active:scale-[0.97]">Save</button>
        </form>
    </div>

    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-6">
        <h2 class="text-lg font-semibold mb-1">Users</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Click a user to edit their username, password, or role.</p>

        @if (Model.Users.Count == 0)
        {
            <p class="text-brown-500 dark:text-brown-400 text-sm">No users found.</p>
        }
        else
        {
            <div id="usersList" class="flex flex-col divide-y divide-brown-200 dark:divide-brown-700 mb-5">
                @foreach (var u in Model.Users)
                {
                    var isSelf = u.Username == User.Identity!.Name;
                    <div class="user-row @(isSelf ? "" : "group") py-3">
                        @if (isSelf)
                        {
                            <div class="flex items-center justify-between text-sm">
                                <span class="flex items-center gap-2">
                                    <span>@u.Username</span>
                                    <span class="text-xs text-brown-400 dark:text-brown-500">(you — managed above, under "Your account")</span>
                                </span>
                                <span class="text-xs font-semibold uppercase tracking-wide text-brown-600 dark:text-brown-400 border border-brown-500 dark:border-brown-400 rounded-full px-2.5 py-0.5">admin</span>
                            </div>
                        }
                        else
                        {
                            <details class="group/row">
                                <summary class="flex items-center justify-between text-sm cursor-pointer list-none">
                                    <span>@u.Username</span>
                                    <span class="flex items-center gap-3">
                                        @if (u.IsAdmin)
                                        {
                                            <span class="text-xs font-semibold uppercase tracking-wide text-brown-600 dark:text-brown-400 border border-brown-500 dark:border-brown-400 rounded-full px-2.5 py-0.5">admin</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-brown-500 dark:text-brown-400">user</span>
                                        }
                                        <span class="text-brown-400 dark:text-brown-500 text-xs group-open/row:rotate-180 transition-transform">&#9662;</span>
                                    </span>
                                </summary>

                                <div class="mt-3 p-4 rounded-lg bg-brown-50 dark:bg-brown-900/60 flex flex-col gap-4">
                                    <form method="post" asp-page-handler="UpdateUser" class="flex flex-col gap-4">
                                        <input type="hidden" name="targetUsername" value="@u.Username" />
                                        <div>
                                            <label class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">New username</label>
                                            <input type="text" name="editUsername" placeholder="(unchanged)"
                                                   class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-white dark:bg-brown-800 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">New password (8+ chars, letters and numbers)</label>
                                            <input type="password" name="editPassword" placeholder="(unchanged)" minlength="8"
                                                   pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" title="At least 8 characters, with letters and numbers"
                                                   class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-white dark:bg-brown-800 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">Role</label>
                                            <select name="editRole" class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-white dark:bg-brown-800 text-brown-800 dark:text-brown-100 text-sm">
                                                <option value="">(unchanged)</option>
                                                <option value="true">Admin</option>
                                                <option value="false">User</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="self-start px-4 py-1.5 rounded-md bg-brown-500 hover:bg-brown-600 text-white font-semibold text-xs transition active:scale-[0.97]">Save changes</button>
                                    </form>

                                    <form method="post" asp-page-handler="DeleteUser" class="pt-2 border-t border-brown-200 dark:border-brown-700">
                                        <input type="hidden" name="targetUsername" value="@u.Username" />
                                        <button type="submit" class="mt-2 px-4 py-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white font-semibold text-xs transition active:scale-[0.97]">Delete user</button>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>
                }
            </div>
        }

        <details>
            <summary class="cursor-pointer text-sm font-medium text-brown-600 dark:text-brown-400 hover:underline list-none">+ Add a user</summary>
            <form method="post" asp-page-handler="CreateUser" class="mt-3 flex flex-col gap-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">Username</label>
                        <input type="text" name="NewUserUsername" value="@Model.NewUserUsername"
                               class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium mb-1 text-brown-500 dark:text-brown-400">Password (8+ chars, letters and numbers)</label>
                        <input type="password" name="NewUserPassword" minlength="8"
                               pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" title="At least 8 characters, with letters and numbers"
                               class="w-full px-2.5 py-1.5 rounded-md border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                    </div>
                </div>
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="NewUserIsAdmin" value="true" class="rounded border-brown-300 dark:border-brown-600" />
                    Make this user an admin
                </label>
                <button type="submit" class="self-start px-4 py-2 rounded-lg bg-brown-500 hover:bg-brown-600 text-white font-semibold text-sm transition active:scale-[0.97]">Create user</button>
            </form>
        </details>
    </div>
    </div>

    <div id="tab-prompts" class="admin-panel hidden">
    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-6">
        <h2 class="text-lg font-semibold mb-1">Prompts</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Every prompt on this server, grouped by owner. Click a user to see theirs.</p>

        @if (Model.Prompts.Count == 0)
        {
            <p class="text-brown-500 dark:text-brown-400 text-sm">No prompts yet.</p>
        }
        else
        {
            var promptsByOwner = Model.Prompts
                .GroupBy(p => p.Owner ?? "(legacy, no owner)")
                .OrderBy(g => g.Key, StringComparer.Ordinal);
            <div id="promptsList" class="flex flex-col divide-y divide-brown-200 dark:divide-brown-700">
                @foreach (var ownerGroup in promptsByOwner)
                {
                    <details class="owner-group group/owner py-2.5">
                        <summary class="flex items-center justify-between text-sm cursor-pointer list-none">
                            <span>@ownerGroup.Key</span>
                            <span class="flex items-center gap-3">
                                <span class="text-xs text-brown-500 dark:text-brown-400">@ownerGroup.Count() prompt@(ownerGroup.Count() == 1 ? "" : "s")</span>
                                <span class="text-brown-400 dark:text-brown-500 text-xs group-open/owner:rotate-180 transition-transform">&#9662;</span>
                            </span>
                        </summary>

                        <div class="mt-3 pl-1 flex flex-col divide-y divide-brown-200 dark:divide-brown-700">
                            @foreach (var p in ownerGroup)
                            {
                                <div class="prompt-row flex items-center justify-between gap-3 py-2.5 text-sm">
                                    <a asp-page="/Prompt" asp-route-name="@p.Name" class="font-medium hover:text-brown-600 dark:hover:text-brown-400 transition truncate min-w-0">@p.Name</a>
                                    <form method="post" asp-page-handler="DeletePrompt">
                                        <input type="hidden" name="name" value="@p.Name" />
                                        <button type="submit" class="flex-none px-3 py-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white font-semibold text-xs transition active:scale-[0.97]">Delete</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </div>
    </div>

    <div id="tab-danger" class="admin-panel hidden">
    <div class="bg-white dark:bg-brown-800 border border-red-500/40 rounded-xl p-5 sm:p-6">
        <h2 class="text-lg font-semibold mb-1 text-red-600 dark:text-red-400">Danger zone</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Wipes every prompt, QA checkpoint, build record, and generated site on this server, for every user. Cannot be undone.</p>
        <form method="post" asp-page-handler="Reset">
            <button type="submit"
                    class="px-5 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-semibold text-sm transition active:scale-[0.97]">
                Reset entire store
            </button>
        </form>
    </div>
    </div>

    <p class="mt-8 text-sm">
        <a asp-page="/Dashboard" class="text-brown-600 dark:text-brown-400 hover:underline">Go to the prompt dashboard &rarr;</a>
    </p>
</section>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll('.admin-tab');
            var panels = { users: document.getElementById('tab-users'), prompts: document.getElementById('tab-prompts'), danger: document.getElementById('tab-danger') };
            var activeClasses = ['border-brown-500', 'text-brown-600', 'dark:text-brown-400'];
            var inactiveClasses = ['border-transparent', 'text-brown-500', 'dark:text-brown-400'];
            var currentTab = 'users';

            function setTab(name) {
                currentTab = name;
                tabs.forEach(function (tab) {
                    var isActive = tab.dataset.tab === name;
                    tab.classList.remove.apply(tab.classList, activeClasses.concat(inactiveClasses));
                    tab.classList.add.apply(tab.classList, isActive ? activeClasses : inactiveClasses);
                });
                Object.keys(panels).forEach(function (key) {
                    panels[key].classList.toggle('hidden', key !== name);
                });
                try { localStorage.setItem('promptvcs-admin-tab', name); } catch (e) { }
            }

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () { setTab(tab.dataset.tab); });
            });

            var stored = null;
            try { stored = localStorage.getItem('promptvcs-admin-tab'); } catch (e) { }
            setTab(panels[stored] ? stored : 'users');

            // Global search — filters the users list and the prompts list
            // (grouped by owner) at once, from whichever tab is open, and
            // auto-switches to whichever tab actually has matches so a
            // search never looks like it found nothing just because the
            // wrong tab happened to be showing.
            var searchInput = document.getElementById('adminSearch');
            var noResults = document.getElementById('adminSearchNoResults');
            var noResultsQuery = document.getElementById('adminSearchNoResultsQuery');
            var userRows = document.querySelectorAll('#usersList .user-row');
            var ownerGroups = document.querySelectorAll('#promptsList .owner-group');

            function applySearch() {
                var query = searchInput.value.trim().toLowerCase();

                var userMatches = 0;
                userRows.forEach(function (row) {
                    var match = !query || row.textContent.toLowerCase().indexOf(query) !== -1;
                    row.classList.toggle('hidden', !match);
                    if (match) userMatches++;
                });

                var promptMatches = 0;
                ownerGroups.forEach(function (group) {
                    if (query && group.dataset.wasOpen === undefined) {
                        group.dataset.wasOpen = group.open ? '1' : '0';
                    }

                    var ownerMatches = !query || group.querySelector('summary').textContent.toLowerCase().indexOf(query) !== -1;
                    var rows = group.querySelectorAll('.prompt-row');
                    var groupHasMatch = ownerMatches;
                    rows.forEach(function (row) {
                        var rowMatch = !query || ownerMatches || row.textContent.toLowerCase().indexOf(query) !== -1;
                        row.classList.toggle('hidden', !rowMatch);
                        if (rowMatch) { groupHasMatch = true; promptMatches++; }
                    });

                    group.classList.toggle('hidden', query !== '' && !groupHasMatch);
                    if (query) {
                        if (groupHasMatch) group.open = true;
                    } else if (group.dataset.wasOpen !== undefined) {
                        group.open = group.dataset.wasOpen === '1';
                        delete group.dataset.wasOpen;
                    }
                });

                if (query && userMatches === 0 && promptMatches === 0) {
                    noResultsQuery.textContent = searchInput.value.trim();
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }

                if (query && currentTab !== 'danger') {
                    if (currentTab === 'users' && userMatches === 0 && promptMatches > 0) setTab('prompts');
                    else if (currentTab === 'prompts' && promptMatches === 0 && userMatches > 0) setTab('users');
                }
            }

            searchInput.addEventListener('input', applySearch);
        })();
    </script>
}
