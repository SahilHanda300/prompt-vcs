@page
@model PromptVcs.Web.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<section class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <h1 class="text-2xl sm:text-3xl font-bold mb-2">Settings</h1>
    <p class="text-brown-500 dark:text-brown-400 mb-8">Signed in as <strong class="text-brown-800 dark:text-brown-100 font-semibold">@Model.CurrentUsername</strong>.</p>

    <partial name="_Toast" model="new ToastData(Model.ErrorMessage, Model.SuccessMessage)" />

    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6 mb-6">
        <h2 class="text-lg font-semibold mb-1">Change username</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Used to log in to the web app and CLI.</p>
        <form method="post" asp-page-handler="ChangeUsername" class="flex flex-col gap-4 max-w-sm">
            <div>
                <label for="NewUsername" class="block text-sm font-medium mb-1.5">New username</label>
                <input type="text" id="NewUsername" name="NewUsername" value="@Model.NewUsername" autocomplete="username"
                       class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="UsernamePassword" class="block text-sm font-medium mb-1.5">Current password</label>
                <input type="password" id="UsernamePassword" name="UsernamePassword" autocomplete="current-password"
                       class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <button type="submit"
                    class="self-start px-5 py-2.5 rounded-lg bg-brown-500 hover:bg-brown-600 text-white font-semibold text-sm transition active:scale-[0.97]">
                Save username
            </button>
        </form>
    </div>

    <div class="bg-white dark:bg-brown-800 border border-brown-200 dark:border-brown-700 rounded-xl p-5 sm:p-6">
        <h2 class="text-lg font-semibold mb-1">Change password</h2>
        <p class="text-brown-500 dark:text-brown-400 text-sm mb-4">Same account everywhere — the CLI picks up the new password on next login.</p>
        <form method="post" asp-page-handler="ChangePassword" class="flex flex-col gap-4 max-w-sm">
            <div>
                <label for="CurrentPassword" class="block text-sm font-medium mb-1.5">Current password</label>
                <input type="password" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password"
                       class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <div>
                <label for="NewPassword" class="block text-sm font-medium mb-1.5">New password</label>
                <div class="relative">
                    <input type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" minlength="8"
                           pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" title="At least 8 characters, with letters and numbers"
                           class="w-full px-3 py-2.5 pr-11 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
                    <button type="button" id="togglePassword" aria-label="Show password"
                            class="absolute inset-y-0 right-0 flex items-center px-3 text-brown-500 hover:text-brown-800 dark:text-brown-400 dark:hover:text-brown-100">
                        <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <p class="mt-1.5 text-xs text-brown-500 dark:text-brown-400">At least 8 characters, with letters and numbers.</p>
            </div>
            <div>
                <label for="ConfirmNewPassword" class="block text-sm font-medium mb-1.5">Confirm new password</label>
                <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" autocomplete="new-password" minlength="8"
                       class="w-full px-3 py-2.5 rounded-lg border border-brown-300 dark:border-brown-600 bg-brown-50 dark:bg-brown-900 text-brown-800 dark:text-brown-100 text-sm focus:outline-none focus:ring-2 focus:ring-brown-400" />
            </div>
            <button type="submit"
                    class="self-start px-5 py-2.5 rounded-lg bg-brown-500 hover:bg-brown-600 text-white font-semibold text-sm transition active:scale-[0.97]">
                Save password
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('NewPassword');
            var toggle = document.getElementById('togglePassword');
            var icon = document.getElementById('eyeIcon');
            var eyeOpen = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            var eyeOff = '<path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a21.6 21.6 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 8 11 8a21.6 21.6 0 01-2.61 3.79M14.12 14.12a3 3 0 11-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            if (!input || !toggle) return;
            toggle.addEventListener('click', function () {
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.innerHTML = showing ? eyeOpen : eyeOff;
                toggle.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
            });
        })();
    </script>
}
